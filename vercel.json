{
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://iloveresumes.ca/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.iloveresumes.ca"
        }
      ],
      "permanent": true
    }
  ]
}
