# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
.superpowers/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.example
*.rules

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.md

# Playwright CLI output (may contain credentials)
.playwright-cli/

# Agent skills (local installs; restore with: npx skills experimental_install)
.agents/
agent/
.claude/skills/
.cursor/skills/
.cursor/rules/

# Keep project MCP + lockfile tracked
!.cursor/mcp.json
!skills-lock.json
